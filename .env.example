PORT=3100
# PORT_ADMIN=3101 # вимкнено, див. коментар у src/index.js
# GOOGLE
GOOGLE_TYPE=service_account
GOOGLE_PROJECT_ID=
GOOGLE_PRIVATE_KEY_ID=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_CLIENT_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
GOOGLE_CLIENT_X509_CERT_URL=
GOOGLE_UNIVERSE_DOMAIN=googleapis.com
# GEMINI
GEMINI_API_KEY=

# FIREBASE WEB CONFIG — публічний конфіг клієнтського Firebase Web SDK
# (Project settings -> General -> Your apps -> Web app), той самий проєкт,
# що й GOOGLE_* сервіс-акаунт вище. Віддається БЕЗ авторизації на
# GET /api/config/public (див. routers/config.js) — фронтенд більше не
# носить ці значення в собі (VITE_FIREBASE_* прибрані), а питає їх у
# бекенда, вказаного користувачем в застосунку. Ці значення НЕ секретні
# (Firebase сам це документує — захист дають Authorized Domains + Security
# Rules у самій консолі Firebase, не приховування apiKey).
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_STORAGE_BUCKET=
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=
# PG
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=
POSTGRES_PORT=
# BASE PARAMS
BASE_CURRENCY=UAH
