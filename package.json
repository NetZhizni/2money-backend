{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "imports": {
    "#sql/*": "./src/sql/*.js",
    "#util/*": "./src/util/*.js",
    "#services/*": "./src/services/internal/*.js",
    "#middleware/*": "./src/middleware/*.js"
  },
  "scripts": {
    "dev": "nodemon -r dotenv/config src/cluster.js dotenv_config_path=.env",
    "prod": "node src/cluster.js",
    "migrate": "node src/migrate.js --action=up",
    "migrate:create": "node-pg-migrate create test",
    "migrate:up": "node -r dotenv/config src/migrate.js --action=up dotenv_config_path=.env",
    "migrate:down": "node -r dotenv/config src/migrate.js --action=down dotenv_config_path=.env"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "axios": "^1.17.0",
    "express": "^5.2.1",
    "firebase-admin": "^13.10.0",
    "node-pg-migrate": "^8.0.4",
    "pg": "^8.21.0",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "dotenv": "^14.3.2",
    "nodemon": "^3.1.14"
  }
}
