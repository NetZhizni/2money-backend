{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "paths": {
      "#sql/*": ["./src/sql/*"],
      "#util/*": ["./src/util/*"],
      "#services/*": ["./src/services/internal/*"],
      "#middleware/*": ["./src/middleware/*"]
    },
    "checkJs": false,
    "allowSyntheticDefaultImports": true
  },
  "include": ["src/**/*", "package.json"],
  "exclude": ["node_modules", "dist"]
}
